QMainWindow {
    background: #f4f4f4;
}

QWidget#centralwidget {
    background: #f4f4f4;
}

QLabel#lblExpression {
    background: #fafafa;
    color: #7a7a7a;
    font-family: "Segoe UI";
    font-size: 14px;
    min-height: 20px;
    padding: 0 18px;
}

QLineEdit#display {
    background: #fafafa;
    color: #050505;
    border: none;
    border-bottom: 1px solid #e3e3e3;
    border-radius: 0;
    padding: 10px 18px;
    font-family: "Segoe UI";
    font-size: 44px;
    font-weight: 500;
    min-height: 82px;
    selection-background-color: #8ac2ea;
}

QLineEdit#display[error="true"] {
    background: #fafafa;
    color: #a4262c;
    font-size: 22px;
}

QPushButton {
    background: #ffffff;
    color: #111111;
    border: 1px solid #e2e2e2;
    border-radius: 0;
    padding: 12px 4px;
    font-family: "Microsoft YaHei UI";
    font-size: 20px;
    font-weight: 500;
    min-height: 44px;
}

QPushButton:hover {
    background: #f8f8f8;
    border-color: #d0d0d0;
}

QPushButton:pressed {
    background: #ededed;
}

QPushButton[role="function"] {
    background: #fafafa;
    color: #1b1b1b;
    font-size: 17px;
}

QPushButton[role="operator"] {
    background: #ffffff;
    color: #111111;
    font-size: 22px;
}

QPushButton#btnEquals {
    background: #8ac2ea;
    color: #101820;
    border-color: #8ac2ea;
    font-size: 25px;
}

QPushButton#btnClear {
    color: #111111;
}
